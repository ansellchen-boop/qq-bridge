# qq-bridge 本體。等 DSH（與 Docker 容器）起來後再啟動。
[Unit]
Description=qq-bridge (QQ <-> DeepSeek Harness bridge)
After=network-online.target dsh-web.service
Wants=network-online.target dsh-web.service

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
Environment=PATH=/root/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=512
WorkingDirectory=/root/qq-bridge
ExecStart=/root/.nvm/versions/node/v24.21.0/bin/node /root/qq-bridge/src/bridge.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
